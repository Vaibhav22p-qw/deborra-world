{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "docs",
  "buildCommand": "node scripts/build.mjs --hosted",
  "functions": {
    "api/gateway.mjs": { "maxDuration": 30 }
  },
  "rewrites": [
    { "source": "/api/:route(health|config|cart|newsletter)", "destination": "/api/gateway?_route=api/:route" },
    { "source": "/api/store/:operation", "destination": "/api/gateway?_route=api/store/:operation" },
    { "source": "/newsletter/:action(confirm|unsubscribe)", "destination": "/api/gateway?_route=newsletter/:action" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'none'; object-src 'none'; frame-src 'none'; frame-ancestors 'none'; form-action 'self'; style-src 'self'; font-src 'self'; script-src 'self' https://plausible.io; connect-src 'self' https://plausible.io; img-src 'self' https://cdn.shopify.com https://*.myshopify.com" }
      ]
    }
  ]
}
