# This file contains examples. Copy it to .env on the server and keep it out of Git.
APP_ORIGIN=http://127.0.0.1:4173
BIND_HOST=127.0.0.1
PORT=4173
DATABASE_PATH=.data/deborra.sqlite
# For a private TLS proxy that supplies an overwritten X-Forwarded-For header.
TRUSTED_PROXY_IP=

SHOPIFY_ENABLED=false
SHOPIFY_DOMAIN=
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
SHOPIFY_CATEGORY_HANDLES=hair-oils,serums,hair-care,wellness
SHOPIFY_FEATURED_COLLECTION=
SHOPIFY_ACCOUNT_URL=
# Add approved custom hostnames used by the actual hosted checkout, comma-separated.
SHOPIFY_CHECKOUT_HOSTS=

NEWSLETTER_ENABLED=false
NEWSLETTER_SECRET=
NEWSLETTER_CONSENT_VERSION=1
NEWSLETTER_FROM=
RESEND_API_KEY=
