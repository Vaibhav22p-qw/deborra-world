# Copy to .env on the server and keep it out of Git.
APP_ORIGIN=http://127.0.0.1:4173
BIND_HOST=127.0.0.1
PORT=4173
DATABASE_PATH=.data/deborra.sqlite
# For a private TLS proxy supplying an overwritten X-Forwarded-For header.
TRUSTED_PROXY_IP=

# Native D2C Online Payments (Razorpay India — UPI, Cards, Net Banking, Wallets)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
SUPPORT_EMAIL=

# Optional Shopify Storefront Headless integration (overrides native catalog when true)
SHOPIFY_ENABLED=false
SHOPIFY_DOMAIN=
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
SHOPIFY_CATEGORY_HANDLES=hair-oils,serums,hair-care,wellness
SHOPIFY_FEATURED_COLLECTION=
SHOPIFY_ACCOUNT_URL=
SHOPIFY_CHECKOUT_HOSTS=

# Newsletter (local SQLite consent capture works by default; set NEWSLETTER_ENABLED=true with Resend for double opt-in emails)
NEWSLETTER_ENABLED=false
NEWSLETTER_LOCAL_CAPTURE=true
NEWSLETTER_SECRET=
NEWSLETTER_CONSENT_VERSION=1
NEWSLETTER_FROM=
RESEND_API_KEY=
