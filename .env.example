# Copy to .env on the server and keep it out of Git.
APP_ORIGIN=http://127.0.0.1:4173
BIND_HOST=127.0.0.1
PORT=4173
DATABASE_PATH=.data/deborra.sqlite
# For a private TLS proxy supplying an overwritten X-Forwarded-For header.
TRUSTED_PROXY_IP=

# Local fixture mode only. Uses sample data and accepts Razorpay test keys.
NATIVE_CHECKOUT_PREVIEW=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
SUPPORT_EMAIL=

# Shopify Headless storefront and hosted checkout for live orders
SHOPIFY_ENABLED=false
SHOPIFY_DOMAIN=
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
SHOPIFY_CATEGORY_HANDLES=hair-oils,serums,hair-care,wellness
SHOPIFY_FEATURED_COLLECTION=
SHOPIFY_ACCOUNT_URL=
SHOPIFY_CHECKOUT_HOSTS=

# Newsletter with email confirmation
NEWSLETTER_ENABLED=false
NEWSLETTER_LOCAL_CAPTURE=false
NEWSLETTER_SECRET=
NEWSLETTER_CONSENT_VERSION=1
NEWSLETTER_FROM=
RESEND_API_KEY=
